// ============================================================================
// std/string.nz
// Nizam standard library module for String and StringBuilder
//
// This module provides two primary types for working with text:
//   - String:    An immutable(ish), heap-allocated, null-terminated byte string
//                with explicit length and capacity tracking.
//   - StringBuilder: A mutable, growable buffer for incrementally building
//                    strings with amortized O(1) append operations.
//
// Both types own their underlying heap buffers and must be deinitialized
// to avoid memory leaks.  They rely on std.mem for allocation (make, resize,
// drop) and on the C library for strlen/memcpy.
// ============================================================================

// Import memory management primitives from the std.mem module.
//   make(size)    -> allocates a new buffer of `size` bytes
//   drop(ptr)     -> frees a previously allocated buffer
//   resize(ptr, size) -> resizes an allocation, possibly moving it
from std.mem import make, drop, resize
from std.collections import List, Dict

// --- External (C library) functions ---
//
// strlen: returns the length (in bytes, excluding the null terminator)
//         of a null-terminated C string.
// memcpy: copies `n` bytes from `src` to `dest`.  Behaviour is undefined
//         when the regions overlap.
extern fn strlen(s as cstr) as usize
extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
extern fn strstr(haystack as cstr, needle as cstr) as cstr

// ============================================================================
// String
//
// A heap-allocated, null-terminated string that tracks its own length
// and capacity to avoid repeated strlen calls and to support efficient
// appending.
//
// Fields:
//   data     – pointer to a heap-allocated buffer holding the string bytes
//              plus a null terminator at index [len].
//   len      – number of bytes in the string (NOT counting the null terminator)
//   capacity – total size of the allocated buffer (≥ len + 1)
//
// Invariant:  data[len] == 0   (null terminator)
// Invariant:  capacity >= len + 1
// Invariant:  data != None  for a valid initialized String
// ============================================================================
struct String:
    public var data as ptr[u8]
    public var len as usize
    public var capacity as usize

    // -----------------------------------------------------------------
    // String.__init__(self, s, data, len, capacity)
    //
    // Construct a new String from a C-style null-terminated string `s`,
    // or from pre-allocated raw parts.
    // -----------------------------------------------------------------
    public fn __init__(self as ptr[String], s as cstr = None to cstr, data as ptr[u8] = None to ptr[u8], len as usize = 0, capacity as usize = 0):
        if data to ptr != None:
            (deref self).data = data
            (deref self).len = len
            (deref self).capacity = capacity
        elif s to ptr != None:
            let l as usize = strlen(s)
            let cap as usize = l + 1
            let d as ptr[u8] = make[u8](cap) to ptr[u8]
            memcpy(d to ptr, s to ptr, cap)
            (deref self).data = d
            (deref self).len = l
            (deref self).capacity = cap
        else:
            (deref self).data = None to ptr[u8]
            (deref self).len = 0
            (deref self).capacity = 0

    // -----------------------------------------------------------------
    // String.__del__(self)
    //
    // Release the heap buffer owned by this String.
    // -----------------------------------------------------------------
    public fn __del__(self as ptr[String]):
        if (deref self).data to ptr != None:
            drop((deref self).data to ptr)
            (deref self).data = None to ptr[u8]

    // -----------------------------------------------------------------
    // String.__getitem__(self, idx)
    //
    // Get the character at the specified index.
    // -----------------------------------------------------------------
    public fn __getitem__(self as String, idx as usize) -> u8:
        return self.data[idx]

    fn make(s as cstr) as String:
        return String(s)

    fn deinit(self as ptr[String]):
        self.__del__()

    // -----------------------------------------------------------------
    // String.append(self, other)
    //
    // Append the contents of `other` to the end of `self`, growing the
    // underlying buffer when necessary.
    //
    // Algorithm:
    //   1. Compute new_len = self.len + other.len.
    //   2. If new_len >= self.capacity, grow the buffer to
    //      (new_len + 1) * 2  (double the required capacity to amortise
    //      future appends).
    //   3. memcpy other's data into self's buffer starting at the old end.
    //   4. Update self.len.
    //
    // Note: memcpy copies `other.len + 1` bytes so the null terminator
    // is always placed correctly.
    // -----------------------------------------------------------------
    fn append(self as ptr[String], other as ptr[String]):
        let new_len as usize = (deref self).len + (deref other).len
        if new_len >= (deref self).capacity: 
            let new_cap as usize = (new_len + 1) * 2
            (deref self).data = resize((deref self).data to ptr, new_cap) to ptr[u8]
            (deref self).capacity = new_cap
        
        let dest_ptr as ptr[u8] = ref (deref self).data[(deref self).len]
        memcpy(dest_ptr to ptr, (deref other).data to ptr, (deref other).len + 1)
        (deref self).len = new_len

    // ── Case Conversions ──────────────────────────────────────────────────────
    public fn lower(self as String) as String:
        if self.len == 0 to usize:
            return String.make("" to cstr)
        let new_buf as ptr[u8] = make[u8](self.len + 1 to usize) to ptr[u8]
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            if c >= 65 to u8 and c <= 90 to u8:
                new_buf[i] = c + 32 to u8
            else:
                new_buf[i] = c
            i = i + 1 to usize
        new_buf[self.len] = 0 to u8
        return String(data = new_buf, len = self.len, capacity = self.len + 1 to usize)

    public fn upper(self as String) as String:
        if self.len == 0 to usize:
            return String.make("" to cstr)
        let new_buf as ptr[u8] = make[u8](self.len + 1 to usize) to ptr[u8]
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            if c >= 97 to u8 and c <= 122 to u8:
                new_buf[i] = c - 32 to u8
            else:
                new_buf[i] = c
            i = i + 1 to usize
        new_buf[self.len] = 0 to u8
        return String(data = new_buf, len = self.len, capacity = self.len + 1 to usize)

    public fn capitalize(self as String) as String:
        if self.len == 0 to usize:
            return String.make("" to cstr)
        let new_buf as ptr[u8] = make[u8](self.len + 1 to usize) to ptr[u8]
        let c0 as u8 = self.data[0]
        if c0 >= 97 to u8 and c0 <= 122 to u8:
            new_buf[0] = c0 - 32 to u8
        else:
            new_buf[0] = c0
        var i as usize = 1
        while i < self.len:
            let c as u8 = self.data[i]
            if c >= 65 to u8 and c <= 90 to u8:
                new_buf[i] = c + 32 to u8
            else:
                new_buf[i] = c
            i = i + 1 to usize
        new_buf[self.len] = 0 to u8
        return String(data = new_buf, len = self.len, capacity = self.len + 1 to usize)

    public fn casefold(self as String) as String:
        return self.lower()

    public fn swapcase(self as String) as String:
        if self.len == 0 to usize:
            return String.make("" to cstr)
        let new_buf as ptr[u8] = make[u8](self.len + 1 to usize) to ptr[u8]
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            if c >= 65 to u8 and c <= 90 to u8:
                new_buf[i] = c + 32 to u8
            elif c >= 97 to u8 and c <= 122 to u8:
                new_buf[i] = c - 32 to u8
            else:
                new_buf[i] = c
            i = i + 1 to usize
        new_buf[self.len] = 0 to u8
        return String(data = new_buf, len = self.len, capacity = self.len + 1 to usize)

    public fn title(self as String) as String:
        if self.len == 0 to usize:
            return String.make("" to cstr)
        let new_buf as ptr[u8] = make[u8](self.len + 1 to usize) to ptr[u8]
        var in_word as bool = False
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            let is_alpha as bool = (c >= 65 to u8 and c <= 90 to u8) or (c >= 97 to u8 and c <= 122 to u8)
            if is_alpha:
                if not in_word:
                    if c >= 97 to u8 and c <= 122 to u8:
                        new_buf[i] = c - 32 to u8
                    else:
                        new_buf[i] = c
                    in_word = True
                else:
                    if c >= 65 to u8 and c <= 90 to u8:
                        new_buf[i] = c + 32 to u8
                    else:
                        new_buf[i] = c
            else:
                new_buf[i] = c
                in_word = False
            i = i + 1 to usize
        new_buf[self.len] = 0 to u8
        return String(data = new_buf, len = self.len, capacity = self.len + 1 to usize)

    // ── Predicates ────────────────────────────────────────────────────────────
    public fn isalnum(self as String) as bool:
        if self.len == 0 to usize:
            return False
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            let is_ok as bool = (c >= 65 to u8 and c <= 90 to u8) or (c >= 97 to u8 and c <= 122 to u8) or (c >= 48 to u8 and c <= 57 to u8)
            if not is_ok:
                return False
            i = i + 1 to usize
        return True

    public fn isalpha(self as String) as bool:
        if self.len == 0 to usize:
            return False
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            let is_ok as bool = (c >= 65 to u8 and c <= 90 to u8) or (c >= 97 to u8 and c <= 122 to u8)
            if not is_ok:
                return False
            i = i + 1 to usize
        return True

    public fn isascii(self as String) as bool:
        var i as usize = 0
        while i < self.len:
            if self.data[i] > 127 to u8:
                return False
            i = i + 1 to usize
        return True

    public fn isdecimal(self as String) as bool:
        if self.len == 0 to usize:
            return False
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            if c < 48 to u8 or c > 57 to u8:
                return False
            i = i + 1 to usize
        return True

    public fn isdigit(self as String) as bool:
        return self.isdecimal()

    public fn isnumeric(self as String) as bool:
        return self.isdecimal()

    public fn isidentifier(self as String) as bool:
        if self.len == 0 to usize:
            return False
        let c0 as u8 = self.data[0]
        let ok0 as bool = (c0 >= 65 to u8 and c0 <= 90 to u8) or (c0 >= 97 to u8 and c0 <= 122 to u8) or (c0 == 95 to u8)
        if not ok0:
            return False
        var i as usize = 1
        while i < self.len:
            let c as u8 = self.data[i]
            let ok as bool = (c >= 65 to u8 and c <= 90 to u8) or (c >= 97 to u8 and c <= 122 to u8) or (c >= 48 to u8 and c <= 57 to u8) or (c == 95 to u8)
            if not ok:
                return False
            i = i + 1 to usize
        return True

    public fn islower(self as String) as bool:
        if self.len == 0 to usize:
            return False
        var has_cased as bool = False
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            if c >= 65 to u8 and c <= 90 to u8:
                return False
            if c >= 97 to u8 and c <= 122 to u8:
                has_cased = True
            i = i + 1 to usize
        return has_cased

    public fn isupper(self as String) as bool:
        if self.len == 0 to usize:
            return False
        var has_cased as bool = False
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            if c >= 97 to u8 and c <= 122 to u8:
                return False
            if c >= 65 to u8 and c <= 90 to u8:
                has_cased = True
            i = i + 1 to usize
        return has_cased

    public fn istitle(self as String) as bool:
        if self.len == 0 to usize:
            return False
        var has_cased as bool = False
        var in_word as bool = False
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            let is_upper as bool = (c >= 65 to u8 and c <= 90 to u8)
            let is_lower as bool = (c >= 97 to u8 and c <= 122 to u8)
            if is_upper or is_lower:
                has_cased = True
                if not in_word:
                    if is_lower:
                        return False
                    in_word = True
                else:
                    if is_upper:
                        return False
            else:
                in_word = False
            i = i + 1 to usize
        return has_cased

    public fn isspace(self as String) as bool:
        if self.len == 0 to usize:
            return False
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            let is_ws as bool = (c == 32 to u8 or c == 9 to u8 or c == 10 to u8 or c == 13 to u8 or c == 11 to u8 or c == 12 to u8)
            if not is_ws:
                return False
            i = i + 1 to usize
        return True

    public fn isprintable(self as String) as bool:
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            if c < 32 to u8 or c == 127 to u8:
                return False
            i = i + 1 to usize
        return True

    // ── Search and Inspection ─────────────────────────────────────────────────
    public fn find(self as String, sub as cstr, start as i64 = 0 to i64, end_idx as i64 = -1 to i64) as i64:
        if sub to ptr == None or self.len == 0 to usize:
            return -1 to i64
        let sub_len as usize = strlen(sub)
        if sub_len == 0 to usize:
            return if start >= 0 to i64: start else: 0 to i64
        var s_start as i64 = start
        if s_start < 0 to i64:
            s_start = (self.len to i64) + s_start
            if s_start < 0 to i64:
                s_start = 0 to i64
        if s_start >= (self.len to i64):
            return -1 to i64
        var s_end as i64 = end_idx
        if s_end < 0 to i64 or s_end > (self.len to i64):
            s_end = self.len to i64
        if s_start + (sub_len to i64) > s_end:
            return -1 to i64
        var i as i64 = s_start
        let limit as i64 = s_end - (sub_len to i64)
        while i <= limit:
            let ptr_i as ptr[u8] = ref self.data[i to usize]
            if strncmp(ptr_i to cstr, sub, sub_len) == 0:
                return i
            i = i + 1 to i64
        return -1 to i64

    public fn rfind(self as String, sub as cstr, start as i64 = 0 to i64, end_idx as i64 = -1 to i64) as i64:
        if sub to ptr == None or self.len == 0 to usize:
            return -1 to i64
        let sub_len as usize = strlen(sub)
        if sub_len == 0 to usize:
            return if end_idx >= 0 to i64 and end_idx <= (self.len to i64): end_idx else: self.len to i64
        var s_start as i64 = start
        if s_start < 0 to i64:
            s_start = (self.len to i64) + s_start
            if s_start < 0 to i64:
                s_start = 0 to i64
        if s_start >= (self.len to i64):
            return -1 to i64
        var s_end as i64 = end_idx
        if s_end < 0 to i64 or s_end > (self.len to i64):
            s_end = self.len to i64
        if s_start + (sub_len to i64) > s_end:
            return -1 to i64
        var i as i64 = s_end - (sub_len to i64)
        while i >= s_start:
            let ptr_i as ptr[u8] = ref self.data[i to usize]
            if strncmp(ptr_i to cstr, sub, sub_len) == 0:
                return i
            i = i - 1 to i64
        return -1 to i64

    public fn index(self as String, sub as cstr, start as i64 = 0 to i64, end_idx as i64 = -1 to i64) as i64:
        return self.find(sub, start, end_idx)

    public fn rindex(self as String, sub as cstr, start as i64 = 0 to i64, end_idx as i64 = -1 to i64) as i64:
        return self.rfind(sub, start, end_idx)

    public fn count(self as String, sub as cstr, start as i64 = 0 to i64, end_idx as i64 = -1 to i64) as i64:
        if sub to ptr == None or self.len == 0 to usize:
            return 0 to i64
        let sub_len as usize = strlen(sub)
        if sub_len == 0 to usize:
            return (self.len to i64) + 1 to i64
        var s_start as i64 = start
        if s_start < 0 to i64:
            s_start = (self.len to i64) + s_start
            if s_start < 0 to i64:
                s_start = 0 to i64
        var s_end as i64 = end_idx
        if s_end < 0 to i64 or s_end > (self.len to i64):
            s_end = self.len to i64
        if s_start + (sub_len to i64) > s_end:
            return 0 to i64
        var cnt as i64 = 0 to i64
        var i as i64 = s_start
        let limit as i64 = s_end - (sub_len to i64)
        while i <= limit:
            let ptr_i as ptr[u8] = ref self.data[i to usize]
            if strncmp(ptr_i to cstr, sub, sub_len) == 0:
                cnt = cnt + 1 to i64
                i = i + (sub_len to i64)
            else:
                i = i + 1 to i64
        return cnt

    public fn contains(self as String, sub as cstr) as bool:
        return self.find(sub, 0 to i64, -1 to i64) >= 0 to i64

    public fn startswith(self as String, prefix as cstr, start as i64 = 0 to i64, end_idx as i64 = -1 to i64) as bool:
        if prefix to ptr == None:
            return False
        let p_len as usize = strlen(prefix)
        var s_start as i64 = start
        if s_start < 0 to i64:
            s_start = (self.len to i64) + s_start
            if s_start < 0 to i64:
                s_start = 0 to i64
        var s_end as i64 = end_idx
        if s_end < 0 to i64 or s_end > (self.len to i64):
            s_end = self.len to i64
        if s_start + (p_len to i64) > s_end:
            return False
        if p_len == 0 to usize:
            return True
        let ptr_i as ptr[u8] = ref self.data[s_start to usize]
        let res as i32 = strncmp(ptr_i to cstr, prefix, p_len)
        return res == 0

    public fn endswith(self as String, suffix as cstr, start as i64 = 0 to i64, end_idx as i64 = -1 to i64) as bool:
        if suffix to ptr == None:
            return False
        let s_len as usize = strlen(suffix)
        var s_start as i64 = start
        if s_start < 0 to i64:
            s_start = (self.len to i64) + s_start
            if s_start < 0 to i64:
                s_start = 0 to i64
        var s_end as i64 = end_idx
        if s_end < 0 to i64 or s_end > (self.len to i64):
            s_end = self.len to i64
        if s_start + (s_len to i64) > s_end:
            return False
        if s_len == 0 to usize:
            return True
        let offset as usize = (s_end - (s_len to i64)) to usize
        let offset_ptr as ptr[u8] = ref self.data[offset]
        let res as i32 = strncmp(offset_ptr to cstr, suffix, s_len)
        return res == 0

    // ── Trimming and Padding ──────────────────────────────────────────────────
    public fn strip(self as String, chars as cstr = None to cstr) as String:
        let l as String = self.lstrip(chars)
        let res as String = l.rstrip(chars)
        l.deinit()
        return res

    public fn lstrip(self as String, chars as cstr = None to cstr) as String:
        if self.len == 0 to usize:
            return String.make("" to cstr)
        var start as usize = 0
        let is_custom as bool = (chars to ptr != None)
        while start < self.len:
            let c as u8 = self.data[start]
            var found as bool = False
            if is_custom:
                let clen as usize = strlen(chars)
                var ci as usize = 0
                while ci < clen:
                    if (deref ((chars to usize + ci) to ptr[u8])) == c:
                        found = True
                        break
                    ci = ci + 1 to usize
            else:
                if c == 32 to u8 or c == 9 to u8 or c == 10 to u8 or c == 13 to u8:
                    found = True
            if found:
                start = start + 1 to usize
            else:
                break
        if start == self.len:
            return String.make("" to cstr)
        let sub_len as usize = self.len - start
        let new_buf as ptr[u8] = make[u8](sub_len + 1 to usize) to ptr[u8]
        let src_start as ptr[u8] = ref self.data[start]
        memcpy(new_buf to ptr, src_start to ptr, sub_len)
        new_buf[sub_len] = 0 to u8
        return String(data = new_buf, len = sub_len, capacity = sub_len + 1 to usize)

    public fn rstrip(self as String, chars as cstr = None to cstr) as String:
        if self.len == 0 to usize:
            return String.make("" to cstr)
        var end_idx as i64 = (self.len to i64) - 1 to i64
        let is_custom as bool = (chars to ptr != None)
        while end_idx >= 0 to i64:
            let c as u8 = self.data[end_idx to usize]
            var found as bool = False
            if is_custom:
                let clen as usize = strlen(chars)
                var ci as usize = 0
                while ci < clen:
                    if (deref ((chars to usize + ci) to ptr[u8])) == c:
                        found = True
                        break
                    ci = ci + 1 to usize
            else:
                if c == 32 to u8 or c == 9 to u8 or c == 10 to u8 or c == 13 to u8:
                    found = True
            if found:
                end_idx = end_idx - 1 to i64
            else:
                break
        if end_idx < 0 to i64:
            return String.make("" to cstr)
        let sub_len as usize = (end_idx to usize) + 1 to usize
        let new_buf as ptr[u8] = make[u8](sub_len + 1 to usize) to ptr[u8]
        memcpy(new_buf to ptr, self.data to ptr, sub_len)
        new_buf[sub_len] = 0 to u8
        return String(data = new_buf, len = sub_len, capacity = sub_len + 1 to usize)

    public fn center(self as String, width as i64, fillchar as cstr = " " to cstr) as String:
        let w as usize = if width > 0 to i64: width to usize else: 0 to usize
        if w <= self.len:
            return String.make(self.data to cstr)
        let total_pad as usize = w - self.len
        let left_pad as usize = total_pad / 2 to usize
        let right_pad as usize = total_pad - left_pad
        let fill as u8 = if fillchar to ptr != None and strlen(fillchar) > 0 to usize: deref (fillchar to ptr[u8]) else: 32 to u8
        let new_buf as ptr[u8] = make[u8](w + 1 to usize) to ptr[u8]
        var idx as usize = 0
        while idx < left_pad:
            new_buf[idx] = fill
            idx = idx + 1 to usize
        if self.len > 0 to usize:
            let dst as ptr[u8] = ref new_buf[idx]
            memcpy(dst to ptr, self.data to ptr, self.len)
            idx = idx + self.len
        var r_cnt as usize = 0
        while r_cnt < right_pad:
            new_buf[idx] = fill
            idx = idx + 1 to usize
            r_cnt = r_cnt + 1 to usize
        new_buf[w] = 0 to u8
        return String(data = new_buf, len = w, capacity = w + 1 to usize)

    public fn ljust(self as String, width as i64, fillchar as cstr = " " to cstr) as String:
        let w as usize = if width > 0 to i64: width to usize else: 0 to usize
        if w <= self.len:
            return String.make(self.data to cstr)
        let pad as usize = w - self.len
        let fill as u8 = if fillchar to ptr != None and strlen(fillchar) > 0 to usize: deref (fillchar to ptr[u8]) else: 32 to u8
        let new_buf as ptr[u8] = make[u8](w + 1 to usize) to ptr[u8]
        if self.len > 0 to usize:
            memcpy(new_buf to ptr, self.data to ptr, self.len)
        var idx as usize = self.len
        while idx < w:
            new_buf[idx] = fill
            idx = idx + 1 to usize
        new_buf[w] = 0 to u8
        return String(data = new_buf, len = w, capacity = w + 1 to usize)

    public fn rjust(self as String, width as i64, fillchar as cstr = " " to cstr) as String:
        let w as usize = if width > 0 to i64: width to usize else: 0 to usize
        if w <= self.len:
            return String.make(self.data to cstr)
        let pad as usize = w - self.len
        let fill as u8 = if fillchar to ptr != None and strlen(fillchar) > 0 to usize: deref (fillchar to ptr[u8]) else: 32 to u8
        let new_buf as ptr[u8] = make[u8](w + 1 to usize) to ptr[u8]
        var idx as usize = 0
        while idx < pad:
            new_buf[idx] = fill
            idx = idx + 1 to usize
        if self.len > 0 to usize:
            let dst as ptr[u8] = ref new_buf[idx]
            memcpy(dst to ptr, self.data to ptr, self.len)
        new_buf[w] = 0 to u8
        return String(data = new_buf, len = w, capacity = w + 1 to usize)

    public fn zfill(self as String, width as i64) as String:
        let w as usize = if width > 0 to i64: width to usize else: 0 to usize
        if w <= self.len:
            return String.make(self.data to cstr)
        let pad as usize = w - self.len
        let new_buf as ptr[u8] = make[u8](w + 1 to usize) to ptr[u8]
        var has_sign as bool = False
        var sign_byte as u8 = 0 to u8
        if self.len > 0 to usize:
            let first as u8 = self.data[0]
            if first == 43 to u8 or first == 45 to u8:
                has_sign = True
                sign_byte = first
        var out_i as usize = 0
        if has_sign:
            new_buf[0] = sign_byte
            out_i = 1 to usize
        var p_cnt as usize = 0
        while p_cnt < pad:
            new_buf[out_i] = 48 to u8
            out_i = out_i + 1 to usize
            p_cnt = p_cnt + 1 to usize
        let src_offset as usize = if has_sign: 1 to usize else: 0 to usize
        let copy_len as usize = self.len - src_offset
        if copy_len > 0 to usize:
            let src as ptr[u8] = ref self.data[src_offset]
            let dst as ptr[u8] = ref new_buf[out_i]
            memcpy(dst to ptr, src to ptr, copy_len)
        new_buf[w] = 0 to u8
        return String(data = new_buf, len = w, capacity = w + 1 to usize)

    public fn expandtabs(self as String, tabsize as i64 = 8 to i64) as String:
        let ts as usize = if tabsize > 0 to i64: tabsize to usize else: 0 to usize
        if self.len == 0 to usize:
            return String.make("" to cstr)
        var cap as usize = self.len * 2 to usize + 16 to usize
        var buf as ptr[u8] = make[u8](cap) to ptr[u8]
        var b_len as usize = 0
        var col as usize = 0
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            if c == 9 to u8:
                if ts > 0 to usize:
                    let spaces as usize = ts - (col % ts)
                    var s_i as usize = 0
                    while s_i < spaces:
                        if b_len + 1 to usize >= cap:
                            cap = cap * 2 to usize
                            buf = resize(buf to ptr, cap) to ptr[u8]
                        buf[b_len] = 32 to u8
                        b_len = b_len + 1 to usize
                        col = col + 1 to usize
                        s_i = s_i + 1 to usize
            elif c == 10 to u8 or c == 13 to u8:
                if b_len + 1 to usize >= cap:
                    cap = cap * 2 to usize
                    buf = resize(buf to ptr, cap) to ptr[u8]
                buf[b_len] = c
                b_len = b_len + 1 to usize
                col = 0 to usize
            else:
                if b_len + 1 to usize >= cap:
                    cap = cap * 2 to usize
                    buf = resize(buf to ptr, cap) to ptr[u8]
                buf[b_len] = c
                b_len = b_len + 1 to usize
                col = col + 1 to usize
            i = i + 1 to usize
        buf[b_len] = 0 to u8
        return String(data = buf, len = b_len, capacity = cap)

    // ── Splitting and Partitioning ─────────────────────────────────────────────
    public fn split(self as String, sep as cstr = None to cstr, maxsplit as i64 = -1 to i64) as List[String]:
        var res as List[String] = List[String]()
        if self.len == 0 to usize:
            return res
        let is_ws_split as bool = (sep to ptr == None or strlen(sep) == 0 to usize)
        if is_ws_split:
            var cur as usize = 0
            var split_count as i64 = 0 to i64
            while cur < self.len:
                while cur < self.len:
                    let c as u8 = self.data[cur]
                    if c == 32 to u8 or c == 9 to u8 or c == 10 to u8 or c == 13 to u8:
                        cur = cur + 1 to usize
                    else:
                        break
                if cur == self.len:
                    break
                if maxsplit >= 0 to i64 and split_count == maxsplit:
                    let rem_len as usize = self.len - cur
                    let tmp as ptr[u8] = make[u8](rem_len + 1 to usize) to ptr[u8]
                    let src as ptr[u8] = ref self.data[cur]
                    memcpy(tmp to ptr, src to ptr, rem_len)
                    tmp[rem_len] = 0 to u8
                    res.append(String(data = tmp, len = rem_len, capacity = rem_len + 1 to usize))
                    break
                let word_start as usize = cur
                while cur < self.len:
                    let c as u8 = self.data[cur]
                    if c != 32 to u8 and c != 9 to u8 and c != 10 to u8 and c != 13 to u8:
                        cur = cur + 1 to usize
                    else:
                        break
                let w_len as usize = cur - word_start
                let tmp as ptr[u8] = make[u8](w_len + 1 to usize) to ptr[u8]
                let src as ptr[u8] = ref self.data[word_start]
                memcpy(tmp to ptr, src to ptr, w_len)
                tmp[w_len] = 0 to u8
                res.append(String(data = tmp, len = w_len, capacity = w_len + 1 to usize))
                split_count = split_count + 1 to i64
            return res

        let sep_len as usize = strlen(sep)
        var cur_ptr as ptr[u8] = self.data
        let end_ptr as ptr[u8] = ref self.data[self.len]
        var s_cnt as i64 = 0 to i64
        while cur_ptr to usize < end_ptr to usize:
            if maxsplit >= 0 to i64 and s_cnt == maxsplit:
                let rem_len as usize = (end_ptr to usize) - (cur_ptr to usize)
                let tmp as ptr[u8] = make[u8](rem_len + 1 to usize) to ptr[u8]
                memcpy(tmp to ptr, cur_ptr to ptr, rem_len)
                tmp[rem_len] = 0 to u8
                res.append(String(data = tmp, len = rem_len, capacity = rem_len + 1 to usize))
                break
            let found_match as cstr = strstr(cur_ptr to cstr, sep)
            if found_match to ptr == None:
                let rem_len as usize = (end_ptr to usize) - (cur_ptr to usize)
                let tmp as ptr[u8] = make[u8](rem_len + 1 to usize) to ptr[u8]
                memcpy(tmp to ptr, cur_ptr to ptr, rem_len)
                tmp[rem_len] = 0 to u8
                res.append(String(data = tmp, len = rem_len, capacity = rem_len + 1 to usize))
                break
            let seg_len as usize = (found_match to usize) - (cur_ptr to usize)
            let tmp as ptr[u8] = make[u8](seg_len + 1 to usize) to ptr[u8]
            memcpy(tmp to ptr, cur_ptr to ptr, seg_len)
            tmp[seg_len] = 0 to u8
            res.append(String(data = tmp, len = seg_len, capacity = seg_len + 1 to usize))
            s_cnt = s_cnt + 1 to i64
            cur_ptr = (found_match to usize + sep_len) to ptr[u8]
            if cur_ptr to usize == end_ptr to usize:
                let empty_tmp as ptr[u8] = make[u8](1 to usize) to ptr[u8]
                empty_tmp[0] = 0 to u8
                res.append(String(data = empty_tmp, len = 0 to usize, capacity = 1 to usize))
                break
        return res

    public fn rsplit(self as String, sep as cstr = None to cstr, maxsplit as i64 = -1 to i64) as List[String]:
        if maxsplit < 0 to i64 or self.len == 0 to usize:
            return self.split(sep, -1 to i64)
        if maxsplit == 0 to i64:
            var res as List[String] = List[String]()
            res.append(String.make(self.data to cstr))
            return res

        var rev_parts as List[String] = List[String]()
        let is_ws_split as bool = (sep to ptr == None or strlen(sep) == 0 to usize)
        if is_ws_split:
            var cur as i64 = (self.len to i64) - 1 to i64
            var s_cnt as i64 = 0 to i64
            while cur >= 0 to i64:
                while cur >= 0 to i64:
                    let c as u8 = self.data[cur to usize]
                    if c == 32 to u8 or c == 9 to u8 or c == 10 to u8 or c == 13 to u8:
                        cur = cur - 1 to i64
                    else:
                        break
                if cur < 0 to i64:
                    break
                if s_cnt == maxsplit:
                    let rem_len as usize = (cur to usize) + 1 to usize
                    let tmp as ptr[u8] = make[u8](rem_len + 1 to usize) to ptr[u8]
                    memcpy(tmp to ptr, self.data to ptr, rem_len)
                    tmp[rem_len] = 0 to u8
                    rev_parts.append(String(data = tmp, len = rem_len, capacity = rem_len + 1 to usize))
                    break
                let word_end as i64 = cur
                while cur >= 0 to i64:
                    let c as u8 = self.data[cur to usize]
                    if c != 32 to u8 and c != 9 to u8 and c != 10 to u8 and c != 13 to u8:
                        cur = cur - 1 to i64
                    else:
                        break
                let w_start as usize = (cur + 1 to i64) to usize
                let w_len as usize = (word_end - cur) to usize
                let tmp as ptr[u8] = make[u8](w_len + 1 to usize) to ptr[u8]
                let src as ptr[u8] = ref self.data[w_start]
                memcpy(tmp to ptr, src to ptr, w_len)
                tmp[w_len] = 0 to u8
                rev_parts.append(String(data = tmp, len = w_len, capacity = w_len + 1 to usize))
                s_cnt = s_cnt + 1 to i64
        else:
            let sep_len as usize = strlen(sep)
            var end_pos as i64 = self.len to i64
            var s_cnt as i64 = 0 to i64
            while end_pos >= 0 to i64 and s_cnt < maxsplit:
                let idx as i64 = self.rfind(sep, 0 to i64, end_pos)
                if idx < 0 to i64:
                    break
                let seg_start as usize = (idx to usize) + sep_len
                let seg_len as usize = (end_pos to usize) - seg_start
                let tmp as ptr[u8] = make[u8](seg_len + 1 to usize) to ptr[u8]
                if seg_len > 0 to usize:
                    let src as ptr[u8] = ref self.data[seg_start]
                    memcpy(tmp to ptr, src to ptr, seg_len)
                tmp[seg_len] = 0 to u8
                rev_parts.append(String(data = tmp, len = seg_len, capacity = seg_len + 1 to usize))
                s_cnt = s_cnt + 1 to i64
                end_pos = idx
            let rem_len as usize = end_pos to usize
            let tmp as ptr[u8] = make[u8](rem_len + 1 to usize) to ptr[u8]
            if rem_len > 0 to usize:
                memcpy(tmp to ptr, self.data to ptr, rem_len)
            tmp[rem_len] = 0 to u8
            rev_parts.append(String(data = tmp, len = rem_len, capacity = rem_len + 1 to usize))

        var res as List[String] = List[String]()
        var r_i as i64 = rev_parts.length() - 1 to i64
        while r_i >= 0 to i64:
            res.append(rev_parts[r_i])
            r_i = r_i - 1 to i64
        return res

    public fn partition(self as String, sep as cstr) as List[String]:
        var res as List[String] = List[String]()
        if sep to ptr == None or strlen(sep) == 0 to usize:
            res.append(String.make(self.data to cstr))
            res.append(String.make("" to cstr))
            res.append(String.make("" to cstr))
            return res
        let idx as i64 = self.find(sep, 0 to i64, -1 to i64)
        if idx < 0 to i64:
            res.append(String.make(self.data to cstr))
            res.append(String.make("" to cstr))
            res.append(String.make("" to cstr))
        else:
            let sep_len as usize = strlen(sep)
            let p1_len as usize = idx to usize
            let b1 as ptr[u8] = make[u8](p1_len + 1 to usize) to ptr[u8]
            if p1_len > 0 to usize:
                memcpy(b1 to ptr, self.data to ptr, p1_len)
            b1[p1_len] = 0 to u8
            res.append(String(data = b1, len = p1_len, capacity = p1_len + 1 to usize))
            res.append(String.make(sep))
            let p3_start as usize = (idx to usize) + sep_len
            let p3_len as usize = self.len - p3_start
            let b3 as ptr[u8] = make[u8](p3_len + 1 to usize) to ptr[u8]
            if p3_len > 0 to usize:
                let src3 as ptr[u8] = ref self.data[p3_start]
                memcpy(b3 to ptr, src3 to ptr, p3_len)
            b3[p3_len] = 0 to u8
            res.append(String(data = b3, len = p3_len, capacity = p3_len + 1 to usize))
        return res

    public fn rpartition(self as String, sep as cstr) as List[String]:
        var res as List[String] = List[String]()
        if sep to ptr == None or strlen(sep) == 0 to usize:
            res.append(String.make("" to cstr))
            res.append(String.make("" to cstr))
            res.append(String.make(self.data to cstr))
            return res
        let idx as i64 = self.rfind(sep, 0 to i64, -1 to i64)
        if idx < 0 to i64:
            res.append(String.make("" to cstr))
            res.append(String.make("" to cstr))
            res.append(String.make(self.data to cstr))
        else:
            let sep_len as usize = strlen(sep)
            let p1_len as usize = idx to usize
            let b1 as ptr[u8] = make[u8](p1_len + 1 to usize) to ptr[u8]
            if p1_len > 0 to usize:
                memcpy(b1 to ptr, self.data to ptr, p1_len)
            b1[p1_len] = 0 to u8
            res.append(String(data = b1, len = p1_len, capacity = p1_len + 1 to usize))
            res.append(String.make(sep))
            let p3_start as usize = (idx to usize) + sep_len
            let p3_len as usize = self.len - p3_start
            let b3 as ptr[u8] = make[u8](p3_len + 1 to usize) to ptr[u8]
            if p3_len > 0 to usize:
                let src3 as ptr[u8] = ref self.data[p3_start]
                memcpy(b3 to ptr, src3 to ptr, p3_len)
            b3[p3_len] = 0 to u8
            res.append(String(data = b3, len = p3_len, capacity = p3_len + 1 to usize))
        return res

    public fn splitlines(self as String, keepends as bool = False) as List[String]:
        var res as List[String] = List[String]()
        if self.len == 0 to usize:
            return res
        var start as usize = 0
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            if c == 10 to u8 or c == 13 to u8:
                var end_seg as usize = i
                var skip as usize = 1 to usize
                if c == 13 to u8 and (i + 1 to usize) < self.len and self.data[i + 1 to usize] == 10 to u8:
                    skip = 2 to usize
                if keepends:
                    end_seg = i + skip
                let seg_len as usize = end_seg - start
                let buf as ptr[u8] = make[u8](seg_len + 1 to usize) to ptr[u8]
                if seg_len > 0 to usize:
                    let src as ptr[u8] = ref self.data[start]
                    memcpy(buf to ptr, src to ptr, seg_len)
                buf[seg_len] = 0 to u8
                res.append(String(data = buf, len = seg_len, capacity = seg_len + 1 to usize))
                i = i + skip
                start = i
            else:
                i = i + 1 to usize
        if start < self.len:
            let rem_len as usize = self.len - start
            let buf as ptr[u8] = make[u8](rem_len + 1 to usize) to ptr[u8]
            let src as ptr[u8] = ref self.data[start]
            memcpy(buf to ptr, src to ptr, rem_len)
            buf[rem_len] = 0 to u8
            res.append(String(data = buf, len = rem_len, capacity = rem_len + 1 to usize))
        return res

    public fn join(self as String, parts as List[String]) as String:
        let count as i64 = parts.length()
        if count == 0 to i64:
            return String.make("" to cstr)
        var total_len as usize = 0
        var i as i64 = 0
        while i < count:
            let item as String = parts[i]
            total_len = total_len + item.len
            if i > 0 to i64:
                total_len = total_len + self.len
            i = i + 1 to i64

        let out_buf as ptr[u8] = make[u8](total_len + 1 to usize) to ptr[u8]
        var out_idx as usize = 0
        i = 0
        while i < count:
            if i > 0 to i64 and self.len > 0 to usize:
                let dst_sep as ptr[u8] = ref out_buf[out_idx]
                memcpy(dst_sep to ptr, self.data to ptr, self.len)
                out_idx = out_idx + self.len
            let item as String = parts[i]
            if item.len > 0 to usize:
                let dst_item as ptr[u8] = ref out_buf[out_idx]
                memcpy(dst_item to ptr, item.data to ptr, item.len)
                out_idx = out_idx + item.len
            i = i + 1 to i64

        out_buf[total_len] = 0 to u8
        return String(data = out_buf, len = total_len, capacity = total_len + 1 to usize)

    // ── Replacement and Affixes ───────────────────────────────────────────────
    public fn replace(self as String, old_s as cstr, new_s as cstr, count as i64 = -1 to i64) as String:
        if self.len == 0 to usize or old_s to ptr == None or count == 0 to i64:
            return String.make(self.data to cstr)
        let old_len as usize = strlen(old_s)
        if old_len == 0 to usize:
            return String.make(self.data to cstr)
        let new_len as usize = if new_s to ptr != None: strlen(new_s) else: 0 to usize

        var total_matches as usize = 0
        var p as ptr[u8] = self.data
        let end_p as ptr[u8] = ref self.data[self.len]
        while p to usize < end_p to usize:
            if count >= 0 to i64 and (total_matches to i64) == count:
                break
            let m as cstr = strstr(p to cstr, old_s)
            if m to ptr == None:
                break
            total_matches = total_matches + 1 to usize
            p = (m to usize + old_len) to ptr[u8]

        if total_matches == 0 to usize:
            return String.make(self.data to cstr)

        let total_len as usize = self.len + total_matches * new_len - total_matches * old_len
        let out_buf as ptr[u8] = make[u8](total_len + 1 to usize) to ptr[u8]
        var out_idx as usize = 0
        p = self.data
        var repl_cnt as i64 = 0 to i64

        while p to usize < end_p to usize:
            if count >= 0 to i64 and repl_cnt == count:
                let rem_len as usize = (end_p to usize) - (p to usize)
                let dst_rem as ptr[u8] = ref out_buf[out_idx]
                memcpy(dst_rem to ptr, p to ptr, rem_len)
                out_idx = out_idx + rem_len
                break
            let m as cstr = strstr(p to cstr, old_s)
            if m to ptr == None:
                let rem_len as usize = (end_p to usize) - (p to usize)
                let dst_rem as ptr[u8] = ref out_buf[out_idx]
                memcpy(dst_rem to ptr, p to ptr, rem_len)
                out_idx = out_idx + rem_len
                break
            let seg_len as usize = (m to usize) - (p to usize)
            if seg_len > 0 to usize:
                let dst_seg as ptr[u8] = ref out_buf[out_idx]
                memcpy(dst_seg to ptr, p to ptr, seg_len)
                out_idx = out_idx + seg_len
            if new_len > 0 to usize:
                let dst_new as ptr[u8] = ref out_buf[out_idx]
                memcpy(dst_new to ptr, new_s to ptr, new_len)
                out_idx = out_idx + new_len
            repl_cnt = repl_cnt + 1 to i64
            p = (m to usize + old_len) to ptr[u8]

        out_buf[total_len] = 0 to u8
        return String(data = out_buf, len = total_len, capacity = total_len + 1 to usize)

    public fn removeprefix(self as String, prefix as cstr) as String:
        if prefix to ptr == None:
            return String.make(self.data to cstr)
        let p_len as usize = strlen(prefix)
        if p_len == 0 to usize or p_len > self.len:
            return String.make(self.data to cstr)
        if strncmp(self.data to cstr, prefix, p_len) == 0:
            let rem_len as usize = self.len - p_len
            let buf as ptr[u8] = make[u8](rem_len + 1 to usize) to ptr[u8]
            if rem_len > 0 to usize:
                let src as ptr[u8] = ref self.data[p_len]
                memcpy(buf to ptr, src to ptr, rem_len)
            buf[rem_len] = 0 to u8
            return String(data = buf, len = rem_len, capacity = rem_len + 1 to usize)
        return String.make(self.data to cstr)

    public fn removesuffix(self as String, suffix as cstr) as String:
        if suffix to ptr == None:
            return String.make(self.data to cstr)
        let s_len as usize = strlen(suffix)
        if s_len == 0 to usize or s_len > self.len:
            return String.make(self.data to cstr)
        let offset as usize = self.len - s_len
        let src_tail as ptr[u8] = ref self.data[offset]
        if strncmp(src_tail to cstr, suffix, s_len) == 0:
            let buf as ptr[u8] = make[u8](offset + 1 to usize) to ptr[u8]
            if offset > 0 to usize:
                memcpy(buf to ptr, self.data to ptr, offset)
            buf[offset] = 0 to u8
            return String(data = buf, len = offset, capacity = offset + 1 to usize)
        return String.make(self.data to cstr)

    // ── Encoding and Translation ──────────────────────────────────────────────
    public fn encode(self as String) as List[u8]:
        var bytes as List[u8] = List[u8]()
        var i as usize = 0
        while i < self.len:
            bytes.append(self.data[i])
            i = i + 1 to usize
        return bytes

    public fn translate(self as String, table as Dict[i64, i64]) as String:
        if self.len == 0 to usize:
            return String.make("" to cstr)
        var tcap as usize = self.len + 32 to usize
        var tbuf as ptr[u8] = make[u8](tcap) to ptr[u8]
        var t_idx as usize = 0
        var i as usize = 0
        while i < self.len:
            let c as i64 = self.data[i] to i64
            if table.has(c):
                let repl as i64 = table[c]
                if repl >= 0 to i64:
                    if t_idx + 1 to usize >= tcap:
                        tcap = tcap * 2 to usize
                        tbuf = resize(tbuf to ptr, tcap) to ptr[u8]
                    tbuf[t_idx] = repl to u8
                    t_idx = t_idx + 1 to usize
            else:
                if t_idx + 1 to usize >= tcap:
                    tcap = tcap * 2 to usize
                    tbuf = resize(tbuf to ptr, tcap) to ptr[u8]
                tbuf[t_idx] = c to u8
                t_idx = t_idx + 1 to usize
            i = i + 1 to usize
        tbuf[t_idx] = 0 to u8
        return String(data = tbuf, len = t_idx, capacity = tcap)

    public fn maketrans(from_s as cstr, to_s as cstr) as Dict[i64, i64]:
        var table as Dict[i64, i64] = Dict[i64, i64]()
        if from_s to ptr == None or to_s to ptr == None:
            return table
        let f_len as usize = strlen(from_s)
        let t_len as usize = strlen(to_s)
        let min_len as usize = if f_len < t_len: f_len else: t_len
        var i as usize = 0
        while i < min_len:
            let k as i64 = (deref ((from_s to usize + i) to ptr[u8])) to i64
            let v as i64 = (deref ((to_s to usize + i) to ptr[u8])) to i64
            table[k] = v
            i = i + 1 to usize
        return table

    // ── Formatting ────────────────────────────────────────────────────────────
    public fn format_map(self as String, mapping as Dict[String, String]) as String:
        if self.len == 0 to usize:
            return String.make("" to cstr)
        var fcap as usize = self.len + 32 to usize
        var fbuf as ptr[u8] = make[u8](fcap) to ptr[u8]
        var b_idx as usize = 0
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            if c == 123 to u8:
                var j as usize = i + 1 to usize
                var found_brace as bool = False
                while j < self.len:
                    if self.data[j] == 125 to u8:
                        found_brace = True
                        break
                    j = j + 1 to usize
                if found_brace:
                    let k_len as usize = j - (i + 1 to usize)
                    let k_buf as ptr[u8] = make[u8](k_len + 1 to usize) to ptr[u8]
                    let src as ptr[u8] = ref self.data[i + 1 to usize]
                    memcpy(k_buf to ptr, src to ptr, k_len)
                    k_buf[k_len] = 0 to u8
                    let k_str as String = String(data = k_buf, len = k_len, capacity = k_len + 1 to usize)
                    if mapping.has(k_str):
                        let val as String = mapping[k_str]
                        let v_len as usize = val.len
                        if b_idx + v_len + 1 to usize >= fcap:
                            fcap = fcap * 2 to usize
                            fbuf = resize(fbuf to ptr, fcap) to ptr[u8]
                        if v_len > 0 to usize:
                            let dst_v as ptr[u8] = ref fbuf[b_idx]
                            memcpy(dst_v to ptr, val.data to ptr, v_len)
                            b_idx = b_idx + v_len
                    else:
                        var raw_k as usize = i
                        while raw_k <= j:
                            if b_idx + 1 to usize >= fcap:
                                fcap = fcap * 2 to usize
                                fbuf = resize(fbuf to ptr, fcap) to ptr[u8]
                            fbuf[b_idx] = self.data[raw_k]
                            b_idx = b_idx + 1 to usize
                            raw_k = raw_k + 1 to usize
                    k_str.deinit()
                    i = j + 1 to usize
                else:
                    if b_idx + 1 to usize >= fcap:
                        fcap = fcap * 2 to usize
                        fbuf = resize(fbuf to ptr, fcap) to ptr[u8]
                    fbuf[b_idx] = c
                    b_idx = b_idx + 1 to usize
                    i = i + 1 to usize
            else:
                if b_idx + 1 to usize >= fcap:
                    fcap = fcap * 2 to usize
                    fbuf = resize(fbuf to ptr, fcap) to ptr[u8]
                fbuf[b_idx] = c
                b_idx = b_idx + 1 to usize
                i = i + 1 to usize
        fbuf[b_idx] = 0 to u8
        return String(data = fbuf, len = b_idx, capacity = fcap)

    // ── str.format(*args) ─────────────────────────────────────────────────────
    //
    // Positional replacement-field formatting.  Supported syntax:
    //   {}          – automatic field numbering
    //   {0}, {12}   – explicit positional index
    //   {{ }}       – escaped literal braces
    //   {0:>10}     – format spec after ':' is accepted and ignored
    // Named fields ({name}) and conversion flags are left verbatim, since
    // keyword arguments are not representable in this signature.
    public fn format(self as String, args as List[String]) as String:
        if self.len == 0 to usize:
            return String.make("" to cstr)
        var fcap as usize = self.len + 32 to usize
        var fbuf as ptr[u8] = make[u8](fcap) to ptr[u8]
        var b_idx as usize = 0
        var auto_idx as i64 = 0
        let arg_count as i64 = args.length()
        var i as usize = 0
        while i < self.len:
            let c as u8 = self.data[i]
            if c == 123 to u8:
                if i + 1 to usize < self.len and self.data[i + 1 to usize] == 123 to u8:
                    while b_idx >= fcap:
                        fcap = fcap * 2 to usize
                        fbuf = resize(fbuf to ptr, fcap) to ptr[u8]
                    fbuf[b_idx] = 123 to u8
                    b_idx = b_idx + 1 to usize
                    i = i + 2 to usize
                else:
                    var j as usize = i + 1 to usize
                    var found_brace as bool = False
                    while j < self.len:
                        if self.data[j] == 125 to u8:
                            found_brace = True
                            break
                        j = j + 1 to usize
                    if found_brace:
                        let f_start as usize = i + 1 to usize
                        let f_len as usize = j - f_start
                        var arg_index as i64 = -1
                        if f_len == 0 to usize or self.data[f_start] == 58 to u8:
                            arg_index = auto_idx
                            auto_idx = auto_idx + 1 to i64
                        else:
                            var p as usize = f_start
                            var num as i64 = 0
                            var is_num as bool = True
                            while p < j:
                                let fd as i64 = self.data[p] to i64
                                if fd == 58 to i64:
                                    break
                                if fd >= 48 to i64 and fd <= 57 to i64:
                                    num = num * 10 to i64 + (fd - 48 to i64)
                                else:
                                    is_num = False
                                    break
                                p = p + 1 to usize
                            if is_num:
                                arg_index = num
                        if arg_index >= 0 to i64 and arg_index < arg_count:
                            let val as String = args[arg_index]
                            let v_len as usize = val.len
                            while b_idx + v_len >= fcap:
                                fcap = fcap * 2 to usize
                                fbuf = resize(fbuf to ptr, fcap) to ptr[u8]
                            if v_len > 0 to usize:
                                let dst_v as ptr[u8] = ref fbuf[b_idx]
                                memcpy(dst_v to ptr, val.data to ptr, v_len)
                                b_idx = b_idx + v_len
                        else:
                            var raw_k as usize = i
                            while raw_k <= j:
                                while b_idx >= fcap:
                                    fcap = fcap * 2 to usize
                                    fbuf = resize(fbuf to ptr, fcap) to ptr[u8]
                                fbuf[b_idx] = self.data[raw_k]
                                b_idx = b_idx + 1 to usize
                                raw_k = raw_k + 1 to usize
                        i = j + 1 to usize
                    else:
                        while b_idx >= fcap:
                            fcap = fcap * 2 to usize
                            fbuf = resize(fbuf to ptr, fcap) to ptr[u8]
                        fbuf[b_idx] = c
                        b_idx = b_idx + 1 to usize
                        i = i + 1 to usize
            elif c == 125 to u8:
                if i + 1 to usize < self.len and self.data[i + 1 to usize] == 125 to u8:
                    while b_idx >= fcap:
                        fcap = fcap * 2 to usize
                        fbuf = resize(fbuf to ptr, fcap) to ptr[u8]
                    fbuf[b_idx] = 125 to u8
                    b_idx = b_idx + 1 to usize
                    i = i + 2 to usize
                else:
                    while b_idx >= fcap:
                        fcap = fcap * 2 to usize
                        fbuf = resize(fbuf to ptr, fcap) to ptr[u8]
                    fbuf[b_idx] = c
                    b_idx = b_idx + 1 to usize
                    i = i + 1 to usize
            else:
                while b_idx >= fcap:
                    fcap = fcap * 2 to usize
                    fbuf = resize(fbuf to ptr, fcap) to ptr[u8]
                fbuf[b_idx] = c
                b_idx = b_idx + 1 to usize
                i = i + 1 to usize
        fbuf[b_idx] = 0 to u8
        return String(data = fbuf, len = b_idx, capacity = fcap)

    // ── Dunders and Operators ─────────────────────────────────────────────────
    public fn __len__(self as String) as usize:
        return self.len

    public fn __contains__(self as String, sub as cstr) as bool:
        return self.contains(sub)

    public fn __eq__(self as String, other as String) as bool:
        if self.len != other.len:
            return False
        if self.len == 0 to usize:
            return True
        let res as i32 = strncmp(self.data to cstr, other.data to cstr, self.len)
        return res == 0

    public fn __ne__(self as String, other as String) as bool:
        return not self.__eq__(other)

    public fn __add__(self as String, other as String) as String:
        let total_len as usize = self.len + other.len
        let buf as ptr[u8] = make[u8](total_len + 1 to usize) to ptr[u8]
        if self.len > 0 to usize:
            memcpy(buf to ptr, self.data to ptr, self.len)
        if other.len > 0 to usize:
            let dst as ptr[u8] = ref buf[self.len]
            memcpy(dst to ptr, other.data to ptr, other.len)
        buf[total_len] = 0 to u8
        return String(data = buf, len = total_len, capacity = total_len + 1 to usize)

    public fn __mul__(self as String, n as i64) as String:
        if n <= 0 to i64 or self.len == 0 to usize:
            return String.make("" to cstr)
        let count as usize = n to usize
        let total_len as usize = self.len * count
        let buf as ptr[u8] = make[u8](total_len + 1 to usize) to ptr[u8]
        var cur_off as usize = 0
        var rep as usize = 0
        while rep < count:
            let dst as ptr[u8] = ref buf[cur_off]
            memcpy(dst to ptr, self.data to ptr, self.len)
            cur_off = cur_off + self.len
            rep = rep + 1 to usize
        buf[total_len] = 0 to u8
        return String(data = buf, len = total_len, capacity = total_len + 1 to usize)

// ============================================================================
// StringBuilder
//
// A mutable, growable string builder that minimizes reallocations by
// doubling capacity whenever the buffer fills up.
//
// Design notes:
//   - The initial buffer size is 16 bytes.
//   - The buffer is always null-terminated so it is safe to read as cstr.
//   - Two sets of methods exist: the idiomatic short names (append, to_string,
//     deinit) and the longer, more explicit builders (append_builder,
//     builder_to_string, deinit_builder).  Both are equivalent; the short
//     names simply delegate to the builder-named counterparts.
//
// Typical usage:
//   let mut sb as StringBuilder = StringBuilder.make_builder()
//   sb.append_builder("hello ")
//   sb.append_builder("world")
//   let s as String = sb.builder_to_string()
//   sb.deinit_builder()
//   // ... use s ... then s.deinit()
// ============================================================================
struct StringBuilder:
    public var buffer as ptr[u8]
    public var len as usize
    public var capacity as usize

    // -----------------------------------------------------------------
    // StringBuilder.__init__(self)
    //
    // Allocate and initialise a new StringBuilder.
    // -----------------------------------------------------------------
    public fn __init__(self as ptr[StringBuilder]):
        let cap as usize = 16
        let buf as ptr[u8] = make[u8](cap) to ptr[u8]
        buf[0] = 0
        (deref self).buffer = buf
        (deref self).len = 0
        (deref self).capacity = cap

    // -----------------------------------------------------------------
    // StringBuilder.__del__(self)
    //
    // Release the heap buffer owned by this StringBuilder.
    // -----------------------------------------------------------------
    public fn __del__(self as ptr[StringBuilder]):
        if (deref self).buffer to ptr != None:
            drop((deref self).buffer to ptr)
            (deref self).buffer = None to ptr[u8]

    fn make() as StringBuilder:
        return StringBuilder()

    fn make_builder() as StringBuilder:
        return StringBuilder()

    fn make_with_capacity(initial_cap as usize) as StringBuilder:
        var sb as StringBuilder = StringBuilder()
        if initial_cap > 16 to usize:
            sb.buffer = resize(sb.buffer to ptr, initial_cap) to ptr[u8]
            sb.capacity = initial_cap
        return sb

    fn deinit(self as ptr[StringBuilder]):
        self.__del__()

    fn deinit_builder(self as ptr[StringBuilder]):
        self.__del__()

    // -----------------------------------------------------------------
    // StringBuilder.append(self, s)
    //
    // Delegate to append_builder().  Append a null-terminated C string
    // to the builder.
    // -----------------------------------------------------------------
    fn append(self as ptr[StringBuilder], s as cstr):
        self.append_builder(s)

    // -----------------------------------------------------------------
    // StringBuilder.append_slice(self, data, add_len)
    //
    // Append a byte slice of known length without calling strlen().
    // -----------------------------------------------------------------
    fn append_slice(self as ptr[StringBuilder], data as ptr[u8], add_len as usize):
        if add_len == 0 to usize or data == None to ptr[u8]:
            return
        let new_len as usize = (deref self).len + add_len
        if new_len >= (deref self).capacity:
            var new_cap as usize = (deref self).capacity * 2 to usize
            if new_cap <= new_len:
                new_cap = (new_len + 1 to usize) * 2 to usize
            (deref self).buffer = resize((deref self).buffer to ptr, new_cap) to ptr[u8]
            (deref self).capacity = new_cap
        let dest_ptr as ptr[u8] = ref (deref self).buffer[(deref self).len]
        memcpy(dest_ptr to ptr, data to ptr, add_len)
        (deref self).len = new_len
        (deref self).buffer[new_len] = 0 to u8

    // -----------------------------------------------------------------
    // StringBuilder.append_char(self, c)
    //
    // Append a single byte to the builder.
    // -----------------------------------------------------------------
    fn append_char(self as ptr[StringBuilder], c as u8):
        let new_len as usize = (deref self).len + 1 to usize
        if new_len >= (deref self).capacity:
            let new_cap as usize = (deref self).capacity * 2 to usize
            (deref self).buffer = resize((deref self).buffer to ptr, new_cap) to ptr[u8]
            (deref self).capacity = new_cap
        (deref self).buffer[(deref self).len] = c
        (deref self).buffer[new_len] = 0 to u8
        (deref self).len = new_len

    // -----------------------------------------------------------------
    // StringBuilder.append_builder(self, s)
    //
    // Append a null-terminated C string `s` to the internal buffer.
    // -----------------------------------------------------------------
    fn append_builder(self as ptr[StringBuilder], s as cstr):
        if s == None to cstr:
            return
        let add_len as usize = strlen(s)
        self.append_slice(s to ptr[u8], add_len)

    // -----------------------------------------------------------------
    // StringBuilder.to_string(self)
    //
    // Delegate to builder_to_string().  Produce a new String from the
    // current builder contents.
    //
    // The builder's internal buffer is NOT consumed – it can still be
    // appended to after this call.
    // -----------------------------------------------------------------
    fn to_string(self as ptr[StringBuilder]) as String:
        return self.builder_to_string()

    // -----------------------------------------------------------------
    // StringBuilder.builder_to_string(self)
    //
    // Create a fresh String by copying the current builder content.
    //
    // The returned String owns a newly allocated buffer (via String.make),
    // so the caller is responsible for calling .deinit() on it.
    //
    // The StringBuilder itself is unaffected and can continue to be used.
    // -----------------------------------------------------------------
    fn builder_to_string(self as ptr[StringBuilder]) as String:
        return String.make((deref self).buffer to cstr)

// ============================================================================
// Module-level documentation notes:
//
// Memory model:
//   Both String and StringBuilder own heap-allocated buffers.  It is the
//   caller's responsibility to call .deinit() / .deinit_builder() to free
//   those buffers.  Failure to do so leaks memory.
//
// Null safety:
//   After deinitialisation the internal pointer is set to None, so
//   accidental double-free is prevented (the deinit methods are idempotent).
//
// Performance characteristics:
//   String.append       – O(n) in the length of `other` (memcpy).
//                         O(1) amortised reallocation cost via doubling.
//   StringBuilder.append – same as String.append.
//   StringBuilder.builder_to_string – O(n) copy of all buffered bytes.
//
// Thread safety:
//   This module provides NO thread-safety guarantees.  Concurrent
//   mutation of a String or StringBuilder from multiple threads
//   is undefined behaviour.
// ============================================================================

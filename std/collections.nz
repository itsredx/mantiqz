// ============================================================================
// std/collections.nz
// Nizam standard library module for generic collection types.
//
// Currently provides:
//   Set[T]  – a hash-set backed by Dict[T, bool] that stores unique values.
//
// This module is intended to grow over time to include additional
// data structures such as Vec, Deque, HashMap, BTreeMap, etc.
// ============================================================================


// ============================================================================
// Set[T]
//
// A generic set type that maintains a collection of unique items.
// Implemented as a thin wrapper around Dict[T, bool], where the
// dictionary keys are the set elements and the values are always True.
//
// Type parameter:
//   T – the element type (must be usable as a Dict key, i.e. hashable
//       and equatable).
//
// Performance:
//   - add / has / remove are O(1) average-case, O(n) worst-case
//     (delegated to the underlying Dict).
//   - clear is O(n) where n is the current number of elements.
//   - length is O(1) (cached by the underlying Dict).
//
// Example usage:
//   let mut s as Set[i64] = Set[i64]()
//   s.add(42)
//   s.add(7)
//   if s.has(42):
//       // ... use it ...
//   s.remove(7)
//   let cnt as i64 = s.length()
//   s.clear()
//
// Thread safety:
//   No thread-safety guarantees are provided.
// ============================================================================
struct Set[T]:
    // Internal dictionary mapping elements -> True.
    // Uses the existing Dict implementation for all storage and lookup.
    public var _dict as Dict[T, bool] = Dict[T, bool]()

    public fn __init__(self as ptr[Set[T]]):
        (deref self)._dict = Dict[T, bool]()

    public fn init(self as ptr[Set[T]]):
        (deref self)._dict = Dict[T, bool]()

    public fn __getitem__(self as Set[T], item as T) -> bool:
        return self.has(item)

    public fn __setitem__(self as ptr[Set[T]], item as T, val as bool):
        if val:
            self.add(item)
        else:
            let discarded as bool = self.remove(item)

    // -----------------------------------------------------------------
    // Set.add(self, item)
    //
    // Insert `item` into the set.
    //
    // If the item is already present, the set is unchanged (no duplicates).
    //
    // Complexity: O(1) average-case.
    // -----------------------------------------------------------------
    public fn add(self as ptr[Set[T]], item as T):
        (deref self)._dict[item] = True

    // -----------------------------------------------------------------
    // Set.has(self, item) -> bool
    //
    // Return True if `item` is present in the set, False otherwise.
    //
    // Complexity: O(1) average-case.
    // -----------------------------------------------------------------
    public fn has(self as ptr[Set[T]], item as T) as bool:
        return (deref self)._dict.has(item)

    // -----------------------------------------------------------------
    // Set.remove(self as ptr[Set[T]], item) -> bool
    //
    // Remove `item` from the set if it is present.
    //
    // Returns:
    //   True  – if the item was found and removed.
    //   False – if the item was not present.
    //
    // Complexity: O(1) average-case.
    // -----------------------------------------------------------------
    public fn remove(self as ptr[Set[T]], item as T) as bool:
        return (deref self)._dict.remove(item)

    public fn to_list(self as ptr[Set[T]]) as List[T]:
        return (deref self)._dict.keys()

    // -----------------------------------------------------------------
    // Set.clear(self as ptr[Set[T]])
    //
    // Remove all elements from the set.
    //
    // After this call, length() returns 0.
    //
    // Complexity: O(n) where n is the number of elements before clearing.
    // -----------------------------------------------------------------
    public fn clear(self as ptr[Set[T]]):
        (deref self)._dict.clear()

    // -----------------------------------------------------------------
    // Set.length(self as ptr[Set[T]]) -> i64
    //
    // Return the number of distinct elements currently in the set.
    //
    // Complexity: O(1) (the value is cached by the underlying Dict).
    // -----------------------------------------------------------------
    public fn length(self as ptr[Set[T]]) as i64:
        return (deref self)._dict.length()

    public fn count(self as ptr[Set[T]]) as i64:
        return (deref self)._dict.length()

    // ── Set Methods ───────────────────────────────────────────────────────────
    public fn update(self as ptr[Set[T]], other as ptr[Set[T]]):
        let keys as List[T] = other.to_list()
        let count as i64 = keys.length()
        var i as i64 = 0 to i64
        while i < count:
            self.add(keys[i])
            i = i + 1 to i64

    public fn discard(self as ptr[Set[T]], item as T):
        let _ as bool = (deref self)._dict.remove(item)

    public fn copy(self as ptr[Set[T]]) as Set[T]:
        var s as Set[T] = Set[T]()
        s._dict = (deref self)._dict.copy()
        return s

    public fn pop(self as ptr[Set[T]]) as T:
        let keys as List[T] = (deref self)._dict.keys()
        let count as i64 = keys.length()
        if count > 0 to i64:
            let last as T = keys[count - 1 to i64]
            let _ as bool = (deref self)._dict.remove(last)
            return last
        return keys[0 to i64]

    public fn difference(self as ptr[Set[T]], other as ptr[Set[T]]) as Set[T]:
        var res as Set[T] = Set[T]()
        res.init()
        let keys as List[T] = self.to_list()
        let count as i64 = keys.length()
        var i as i64 = 0 to i64
        while i < count:
            let item as T = keys[i]
            if not other.has(item):
                res.add(item)
            i = i + 1 to i64
        return res

    public fn difference_update(self as ptr[Set[T]], other as ptr[Set[T]]):
        let other_keys as List[T] = other.to_list()
        let count as i64 = other_keys.length()
        var i as i64 = 0 to i64
        while i < count:
            let _ as bool = self.remove(other_keys[i])
            i = i + 1 to i64

    public fn intersection(self as ptr[Set[T]], other as ptr[Set[T]]) as Set[T]:
        var res as Set[T] = Set[T]()
        res.init()
        let keys as List[T] = self.to_list()
        let count as i64 = keys.length()
        var i as i64 = 0 to i64
        while i < count:
            let item as T = keys[i]
            if other.has(item):
                res.add(item)
            i = i + 1 to i64
        return res

    public fn intersection_update(self as ptr[Set[T]], other as ptr[Set[T]]):
        let keys as List[T] = self.to_list()
        let count as i64 = keys.length()
        var i as i64 = 0 to i64
        while i < count:
            let item as T = keys[i]
            if not other.has(item):
                let _ as bool = self.remove(item)
            i = i + 1 to i64

    public fn symmetric_difference(self as ptr[Set[T]], other as ptr[Set[T]]) as Set[T]:
        var res as Set[T] = Set[T]()
        res.init()
        let keys1 as List[T] = self.to_list()
        let count1 as i64 = keys1.length()
        var i as i64 = 0 to i64
        while i < count1:
            let item1 as T = keys1[i]
            if not other.has(item1):
                res.add(item1)
            i = i + 1 to i64
        let keys2 as List[T] = other.to_list()
        let count2 as i64 = keys2.length()
        var j as i64 = 0 to i64
        while j < count2:
            let item2 as T = keys2[j]
            if not self.has(item2):
                res.add(item2)
            j = j + 1 to i64
        return res

    public fn symmetric_difference_update(self as ptr[Set[T]], other as ptr[Set[T]]):
        let other_keys as List[T] = other.to_list()
        let count as i64 = other_keys.length()
        var i as i64 = 0 to i64
        while i < count:
            let item as T = other_keys[i]
            if self.has(item):
                let _ as bool = self.remove(item)
            else:
                self.add(item)
            i = i + 1 to i64

    public fn union(self as ptr[Set[T]], other as ptr[Set[T]]) as Set[T]:
        var res as Set[T] = self.copy()
        res.update(other)
        return res

    public fn issubset(self as ptr[Set[T]], other as ptr[Set[T]]) as bool:
        if self.length() > other.length():
            return False
        let keys as List[T] = self.to_list()
        let count as i64 = keys.length()
        var i as i64 = 0 to i64
        while i < count:
            if not other.has(keys[i]):
                return False
            i = i + 1 to i64
        return True

    public fn issuperset(self as ptr[Set[T]], other as ptr[Set[T]]) as bool:
        return other.issubset(self)

    public fn isdisjoint(self as ptr[Set[T]], other as ptr[Set[T]]) as bool:
        let keys as List[T] = self.to_list()
        let count as i64 = keys.length()
        var i as i64 = 0 to i64
        while i < count:
            if other.has(keys[i]):
                return False
            i = i + 1 to i64
        return True

// ============================================================================
// FrozenSet[T]
//
// An immutable generic set type that maintains a collection of unique items.
// Implemented around Dict[T, bool], providing all non-mutating set operations.
// ============================================================================
struct FrozenSet[T]:
    public var _dict as Dict[T, bool] = Dict[T, bool]()

    public fn __init__(self as ptr[FrozenSet[T]]):
        (deref self)._dict = Dict[T, bool]()

    public fn init(self as ptr[FrozenSet[T]]):
        (deref self)._dict = Dict[T, bool]()

    public fn from_set(s as ptr[Set[T]]) as FrozenSet[T]:
        var fs as FrozenSet[T] = FrozenSet[T]()
        fs._dict = (deref s)._dict.copy()
        return fs

    public fn from_list(items as List[T]) as FrozenSet[T]:
        var fs as FrozenSet[T] = FrozenSet[T]()
        fs.init()
        let count as i64 = items.length()
        var i as i64 = 0 to i64
        while i < count:
            fs._dict[items[i]] = True
            i = i + 1 to i64
        return fs

    public fn has(self as ptr[FrozenSet[T]], item as T) as bool:
        return (deref self)._dict.has(item)

    public fn length(self as ptr[FrozenSet[T]]) as i64:
        return (deref self)._dict.length()

    public fn count(self as ptr[FrozenSet[T]]) as i64:
        return (deref self)._dict.length()

    public fn to_list(self as ptr[FrozenSet[T]]) as List[T]:
        return (deref self)._dict.keys()

    public fn copy(self as ptr[FrozenSet[T]]) as FrozenSet[T]:
        var fs as FrozenSet[T] = FrozenSet[T]()
        fs._dict = (deref self)._dict.copy()
        return fs

    public fn issubset(self as ptr[FrozenSet[T]], other as ptr[FrozenSet[T]]) as bool:
        if self.length() > other.length():
            return False
        let keys as List[T] = self.to_list()
        let count as i64 = keys.length()
        var i as i64 = 0 to i64
        while i < count:
            if not other.has(keys[i]):
                return False
            i = i + 1 to i64
        return True

    public fn issuperset(self as ptr[FrozenSet[T]], other as ptr[FrozenSet[T]]) as bool:
        return other.issubset(self)

    public fn isdisjoint(self as ptr[FrozenSet[T]], other as ptr[FrozenSet[T]]) as bool:
        let keys as List[T] = self.to_list()
        let count as i64 = keys.length()
        var i as i64 = 0 to i64
        while i < count:
            if other.has(keys[i]):
                return False
            i = i + 1 to i64
        return True

    public fn union(self as ptr[FrozenSet[T]], other as ptr[FrozenSet[T]]) as FrozenSet[T]:
        var res as FrozenSet[T] = self.copy()
        res._dict.update((deref other)._dict)
        return res

    public fn intersection(self as ptr[FrozenSet[T]], other as ptr[FrozenSet[T]]) as FrozenSet[T]:
        var res as FrozenSet[T] = FrozenSet[T]()
        res.init()
        let keys as List[T] = self.to_list()
        let count as i64 = keys.length()
        var i as i64 = 0 to i64
        while i < count:
            let item as T = keys[i]
            if other.has(item):
                res._dict[item] = True
            i = i + 1 to i64
        return res

    public fn difference(self as ptr[FrozenSet[T]], other as ptr[FrozenSet[T]]) as FrozenSet[T]:
        var res as FrozenSet[T] = FrozenSet[T]()
        res.init()
        let keys as List[T] = self.to_list()
        let count as i64 = keys.length()
        var i as i64 = 0 to i64
        while i < count:
            let item as T = keys[i]
            if not other.has(item):
                res._dict[item] = True
            i = i + 1 to i64
        return res

    public fn symmetric_difference(self as ptr[FrozenSet[T]], other as ptr[FrozenSet[T]]) as FrozenSet[T]:
        var res as FrozenSet[T] = FrozenSet[T]()
        res.init()
        let keys1 as List[T] = self.to_list()
        let count1 as i64 = keys1.length()
        var i as i64 = 0 to i64
        while i < count1:
            let item1 as T = keys1[i]
            if not other.has(item1):
                res._dict[item1] = True
            i = i + 1 to i64
        let keys2 as List[T] = other.to_list()
        let count2 as i64 = keys2.length()
        var j as i64 = 0 to i64
        while j < count2:
            let item2 as T = keys2[j]
            if not self.has(item2):
                res._dict[item2] = True
            j = j + 1 to i64
        return res

// ── Tuple ─────────────────────────────────────────────────────────────
// An immutable ordered sequence of elements of type T, providing full
// parity with Python's tuple data model (Section 3).
struct Tuple[T]:
    public var _items as List[T] = List[T]()

    public fn __init__(self as ptr[Tuple[T]]):
        (deref self)._items = List[T]()

    public fn init(self as ptr[Tuple[T]]):
        (deref self)._items = List[T]()

    public fn from_list(self as ptr[Tuple[T]], items as List[T]):
        (deref self)._items = List[T]()
        let n as i64 = items.length()
        var i as i64 = 0 to i64
        while i < n:
            (deref self)._items.append(items[i])
            i = i + 1 to i64

    public fn length(self as ptr[Tuple[T]]) as i64:
        return (deref self)._items.length()

    public fn count(self as ptr[Tuple[T]], item as T) as i64:
        var c as i64 = 0 to i64
        let n as i64 = (deref self)._items.length()
        var i as i64 = 0 to i64
        while i < n:
            if (deref self)._items[i] == item:
                c = c + 1 to i64
            i = i + 1 to i64
        return c

    public fn index(self as ptr[Tuple[T]], item as T) as i64:
        let n as i64 = (deref self)._items.length()
        var i as i64 = 0 to i64
        while i < n:
            if (deref self)._items[i] == item:
                return i
            i = i + 1 to i64
        return -1 to i64

    public fn get(self as ptr[Tuple[T]], idx as i64) as T:
        return (deref self)._items[idx]

    public fn __getitem__(self as Tuple[T], idx as i64) -> T:
        return self._items[idx]

    public fn contains(self as ptr[Tuple[T]], item as T) as bool:
        return self.index(item) >= 0 to i64

    public fn to_list(self as ptr[Tuple[T]]) as List[T]:
        var res as List[T] = List[T]()
        let n as i64 = (deref self)._items.length()
        var i as i64 = 0 to i64
        while i < n:
            res.append((deref self)._items[i])
            i = i + 1 to i64
        return res

// ── Fixed-Arity Heterogeneous Tuples ──────────────────────────────────
struct Tuple2[A, B]:
    public var v0 as A
    public var v1 as B

    public fn make(v0 as A, v1 as B) as Tuple2[A, B]:
        return Tuple2[A, B](v0 = v0, v1 = v1)

    public fn length(self as ptr[Tuple2[A, B]]) as i64:
        return 2 to i64

    public fn get0(self as ptr[Tuple2[A, B]]) as A:
        return (deref self).v0

    public fn get1(self as ptr[Tuple2[A, B]]) as B:
        return (deref self).v1

struct Tuple3[A, B, C]:
    public var v0 as A
    public var v1 as B
    public var v2 as C

    public fn make(v0 as A, v1 as B, v2 as C) as Tuple3[A, B, C]:
        return Tuple3[A, B, C](v0 = v0, v1 = v1, v2 = v2)

    public fn length(self as ptr[Tuple3[A, B, C]]) as i64:
        return 3 to i64

    public fn get0(self as ptr[Tuple3[A, B, C]]) as A:
        return (deref self).v0

    public fn get1(self as ptr[Tuple3[A, B, C]]) as B:
        return (deref self).v1

    public fn get2(self as ptr[Tuple3[A, B, C]]) as C:
        return (deref self).v2

struct Tuple4[A, B, C, D]:
    public var v0 as A
    public var v1 as B
    public var v2 as C
    public var v3 as D

    public fn make(v0 as A, v1 as B, v2 as C, v3 as D) as Tuple4[A, B, C, D]:
        return Tuple4[A, B, C, D](v0 = v0, v1 = v1, v2 = v2, v3 = v3)

    public fn length(self as ptr[Tuple4[A, B, C, D]]) as i64:
        return 4 to i64

    public fn get0(self as ptr[Tuple4[A, B, C, D]]) as A:
        return (deref self).v0

    public fn get1(self as ptr[Tuple4[A, B, C, D]]) as B:
        return (deref self).v1

    public fn get2(self as ptr[Tuple4[A, B, C, D]]) as C:
        return (deref self).v2

    public fn get3(self as ptr[Tuple4[A, B, C, D]]) as D:
        return (deref self).v3

// ── Dictionary Views ──────────────────────────────────────────────────
struct DictItems[K, V]:
    public var _dict as Dict[K, V]

    public fn make(d as Dict[K, V]) as DictItems[K, V]:
        return DictItems[K, V](_dict = d)

    public fn length(self as ptr[DictItems[K, V]]) as usize:
        return (deref self)._dict.length()

    public fn len(self as ptr[DictItems[K, V]]) as usize:
        return (deref self)._dict.length()

    public fn keys(self as ptr[DictItems[K, V]]) as List[K]:
        return (deref self)._dict.keys()

    public fn values(self as ptr[DictItems[K, V]]) as List[V]:
        return (deref self)._dict.values()

    public fn mapping(self as ptr[DictItems[K, V]]) as Dict[K, V]:
        return (deref self)._dict

    public fn to_list(self as ptr[DictItems[K, V]]) as List[Tuple2[K, V]]:
        var res as List[Tuple2[K, V]] = List[Tuple2[K, V]]()
        let ks as List[K] = (deref self)._dict.keys()
        let vs as List[V] = (deref self)._dict.values()
        let n as i64 = ks.length() to i64
        var i as i64 = 0 to i64
        while i < n:
            res.append(Tuple2[K, V](v0 = ks[i], v1 = vs[i]))
            i = i + 1 to i64
        return res

// ── Bytes ─────────────────────────────────────────────────────────────
// Immutable sequence of bytes, providing full parity with Python's bytes
// data model (Section 11).
extern fn __mantiq_list_fromhex(out_list as ptr, hex_str as cstr)
extern fn __mantiq_list_hex(out_str as ptr, list_addr as ptr)
extern fn __mantiq_list_decode(out_str as ptr, list_addr as ptr)
extern fn __mantiq_list_insert(list_addr as ptr, index as i64, elem_addr as ptr, elem_size as i64)
extern fn __mantiq_list_remove(list_addr as ptr, elem_addr as ptr, elem_size as i64) as i8
extern fn __mantiq_list_pop(list_addr as ptr, out_addr as ptr, elem_size as i64) as i8
extern fn __mantiq_list_pop_index(list_addr as ptr, index as i64, out_addr as ptr, elem_size as i64) as i8

struct Bytes:
    public var _bytes as List[u8] = List[u8]()

    public fn __init__(self as ptr[Bytes]):
        (deref self)._bytes = List[u8]()

    public fn init(self as ptr[Bytes]):
        (deref self)._bytes = List[u8]()

    public fn from_list(l as List[u8]) as Bytes:
        var b as Bytes = Bytes()
        let n as i64 = l.length()
        var i as i64 = 0 to i64
        while i < n:
            b._bytes.append(l[i])
            i = i + 1 to i64
        return b

    public fn from_str(s as String) as Bytes:
        var b as Bytes = Bytes()
        let n as i64 = s.len to i64
        var i as i64 = 0 to i64
        while i < n:
            b._bytes.append(s.data[i])
            i = i + 1 to i64
        return b

    public fn from_cstr(cs as cstr) as Bytes:
        var b as Bytes = Bytes()
        if cs != None to cstr:
            extern fn strlen(s as cstr) as usize
            let n as i64 = strlen(cs) to i64
            var i as i64 = 0 to i64
            while i < n:
                b._bytes.append(cs[i])
                i = i + 1 to i64
        return b

    public fn fromhex(hex_str as cstr) as Bytes:
        var b as Bytes = Bytes()
        __mantiq_list_fromhex((ref b._bytes) to ptr, hex_str)
        return b

    public fn length(self as ptr[Bytes]) as i64:
        return (deref self)._bytes.length()

    public fn get(self as ptr[Bytes], idx as i64) as u8:
        return (deref self)._bytes[idx]

    public fn __getitem__(self as Bytes, idx as i64) -> u8:
        return self._bytes[idx]

    public fn count(self as ptr[Bytes], byte_val as u8) as i64:
        var c as i64 = 0 to i64
        let n as i64 = self.length()
        var i as i64 = 0 to i64
        while i < n:
            if (deref self)._bytes[i] == byte_val:
                c = c + 1 to i64
            i = i + 1 to i64
        return c

    public fn find(self as ptr[Bytes], byte_val as u8) as i64:
        let n as i64 = self.length()
        var i as i64 = 0 to i64
        while i < n:
            if (deref self)._bytes[i] == byte_val:
                return i
            i = i + 1 to i64
        return -1 to i64

    public fn index(self as ptr[Bytes], byte_val as u8) as i64:
        return self.find(byte_val)

    public fn rfind(self as ptr[Bytes], byte_val as u8) as i64:
        let n as i64 = self.length()
        var i as i64 = n - 1 to i64
        while i >= 0 to i64:
            if (deref self)._bytes[i] == byte_val:
                return i
            i = i - 1 to i64
        return -1 to i64

    public fn rindex(self as ptr[Bytes], byte_val as u8) as i64:
        return self.rfind(byte_val)

    public fn contains(self as ptr[Bytes], byte_val as u8) as bool:
        return self.find(byte_val) >= 0 to i64

    public fn startswith(self as ptr[Bytes], prefix as ptr[Bytes]) as bool:
        let plen as i64 = prefix.length()
        if plen > self.length():
            return False
        var i as i64 = 0 to i64
        while i < plen:
            if (deref self)._bytes[i] != prefix.get(i):
                return False
            i = i + 1 to i64
        return True

    public fn endswith(self as ptr[Bytes], suffix as ptr[Bytes]) as bool:
        let slen as i64 = suffix.length()
        let tlen as i64 = self.length()
        if slen > tlen:
            return False
        let offset as i64 = tlen - slen
        var i as i64 = 0 to i64
        while i < slen:
            if (deref self)._bytes[offset + i] != suffix.get(i):
                return False
            i = i + 1 to i64
        return True

    public fn removeprefix(self as ptr[Bytes], prefix as ptr[Bytes]) as Bytes:
        if self.startswith(prefix):
            var res as Bytes = Bytes()
            let plen as i64 = prefix.length()
            let n as i64 = self.length()
            var i as i64 = plen
            while i < n:
                res._bytes.append((deref self)._bytes[i])
                i = i + 1 to i64
            return res
        return Bytes.from_list((deref self)._bytes)

    public fn removesuffix(self as ptr[Bytes], suffix as ptr[Bytes]) as Bytes:
        if self.endswith(suffix):
